---
import GitHub from "../icons/GitHub.astro";
import { getI18N, getLocale } from "../i18n/index";

interface ProjectImage {
  /** Thumbnail shown in the card. */
  src: string;
  /** Optional high-resolution version, downloaded only when the lightbox opens. */
  full?: string;
  alt: string;
  width: number;
  height: number;
}

interface Props {
  title: string;
  description: string;
  gitHubUrl?: string;
  technologies?: string[];
  highlights?: string[];
  /** Several screenshots shown as a gallery (each one opens full size). Takes precedence over `image`. */
  images?: ProjectImage[];
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
}

const {
  title,
  description,
  gitHubUrl = "https://github.com/Javiguegadev",
  technologies = [],
  highlights = [],
  images,
  image,
  imageAlt = title,
  imageWidth = 800,
  imageHeight = 384,
} = Astro.props;

const shots: ProjectImage[] =
  images && images.length > 0
    ? images
    : image
      ? [{ src: image, alt: imageAlt, width: imageWidth, height: imageHeight }]
      : [];

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
const stack = new Intl.ListFormat(getLocale(currentLocale), {
  type: "conjunction",
}).format(technologies);
---

<article class="project">
  {
    shots.length > 0 && (
      <div class:list={["gallery", { multiple: shots.length > 1 }]}>
        {shots.map((shot) => (
          <figure class="shot">
            <a
              href={shot.full ?? shot.src}
              target="_blank"
              rel="noopener"
              data-lightbox={title}
              data-lightbox-thumb={shot.src}
              data-lightbox-alt={shot.alt}
              aria-label={`${i18n.PROJECT_IMAGE_ENLARGE}: ${shot.alt}`}
            >
              <img
                src={shot.src}
                alt={shot.alt}
                width={shot.width}
                height={shot.height}
                loading="lazy"
                decoding="async"
              />
            </a>
          </figure>
        ))}
      </div>
    )
  }
  <div class="body">
    <h3>{title}</h3>
    <p>{description}</p>
    {
      highlights.length > 0 && (
        <ul class="highlights">
          {highlights.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )
    }
    {stack && <p class="stack">{i18n.PROJECT_STACK} {stack}</p>}
    <a class="button button-secondary" href={gitHubUrl} target="_blank" rel="noopener noreferrer">
      <GitHub /> {i18n.CARD_LINK_TITLE}
    </a>
  </div>
</article>

<style>
  .project {
    display: grid;
    gap: 1.5rem;
  }
  .gallery {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .gallery.multiple {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .shot {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    background: var(--surface);
  }
  .shot a {
    display: block;
    cursor: zoom-in;
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.3s ease;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .shot a:hover img {
      transform: scale(1.03);
    }
  }
  .shot a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  h3 {
    font-size: 1.3125rem; /* 21px */
    margin-bottom: 0.5rem;
  }
  .highlights {
    margin: 0.75rem 0 0;
    padding-left: 0;
    list-style: none;
    display: grid;
    gap: 0.375rem;
  }
  .highlights li {
    position: relative;
    padding-left: 1.25rem;
  }
  .highlights li::before {
    content: "";
    position: absolute;
    left: 0.25rem;
    top: 0.65em;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--accent);
  }
  .stack {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .button {
    margin-top: 1.25rem;
  }
</style>
